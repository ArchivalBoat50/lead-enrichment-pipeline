# Copy to .env and fill in your own values. Never commit .env.

# Stage 1 -- Apify personal API token.
# Apify Console -> Settings -> Integrations -> Personal API token.
APIFY_TOKEN=apify_api_replace_me

# Stage 3 -- LLM extraction API key.
# Used by stage3_extract.py, which is NOT in this repository yet.
ANTHROPIC_API_KEY=replace_me

# Stage 4 -- per-email verification API key.
# Used by stage4_verify_load.py, which is NOT in this repository yet.
# Only needed at the final, paid verification step.
MILLIONVERIFIER_KEY=replace_me
